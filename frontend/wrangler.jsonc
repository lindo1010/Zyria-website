{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "zyria-website",
    "compatibility_date": "2026-08-16",
    "assets": {
      "directory": "./dist/frontend/browser",
      "not_found_handling": "single-page-application"
    },
    "observability": {
      "enabled": true
    }
